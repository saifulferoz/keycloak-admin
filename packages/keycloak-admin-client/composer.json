{
    "name": "feroz/keycloak-admin-client",
    "description": "Enterprise-grade standalone PHP client for Keycloak Admin REST API",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Saiful Islam Feroz",
            "email": "saiful.feroz@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0|^2.0",
        "psr/simple-cache": "^1.0|^2.0|^3.0",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6",
        "http-interop/http-factory-guzzle": "^1.2",
        "symfony/cache": "^6.4|^7.0|^8.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "To use Guzzle as PSR-18 HTTP client",
        "symfony/http-client": "To use Symfony HttpClient with PSR-18 adapter",
        "psr/simple-cache-implementation": "To cache authentication tokens between requests"
    },
    "autoload": {
        "psr-4": {
            "Feroz\\KeycloakAdmin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Feroz\\KeycloakAdmin\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
