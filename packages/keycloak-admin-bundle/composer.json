{
    "name": "feroz/keycloak-admin-bundle",
    "description": "Symfony Bundle for Keycloak Admin REST API integration",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Saiful Islam Feroz",
            "email": "saiful.feroz@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "feroz/keycloak-admin-client": "*@dev",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/http-client": "^6.4|^7.0|^8.0",
        "symfony/console": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0",
        "symfony/yaml": "^6.4|^7.0|^8.0",
        "symfony/cache": "^6.4|^7.0|^8.0",
        "symfony/web-profiler-bundle": "^6.4|^7.0|^8.0",
        "twig/twig": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "Feroz\\KeycloakAdminBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Feroz\\KeycloakAdminBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
